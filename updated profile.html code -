<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Profile - MindEase</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-100 min-h-screen">
  <header class="bg-indigo-700 py-4 shadow-md">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <a href="index.html" class="flex items-center space-x-3">
        <i data-lucide="heart-pulse" class="w-7 h-7 text-white"></i>
        <h1 class="text-white text-xl font-semibold">MindEase</h1>
      </a>
      <div>
        <a href="index.html" class="text-indigo-200 hover:text-white px-3 py-1 rounded">Discussion</a>
        <button id="logout-btn" class="bg-indigo-500 text-white px-3 py-1 rounded ml-4">Logout</button>
      </div>
    </nav>
  </header>

  <main class="max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <div class="lg:col-span-1">
        <section class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-semibold mb-4 text-gray-800">Friend Requests</h3>
          <div id="requestsList" class="space-y-4">
            </div>
        </section>
      </div>

      <div class="lg:col-span-2">
        <section class="bg-white rounded-lg shadow p-6">
          
          <div class="flex items-center sm:items-start gap-6">
            <div class="flex-shrink-0">
              <img id="avatarImg" src="https://via.placeholder.com/120" alt="avatar" class="w-28 h-28 rounded-full object-cover border-2 border-gray-200" />
              <div class="mt-3 text-center">
                <input id="avatarFile" type="file" accept="image/*" class="hidden" />
                <button id="changeAvatarBtn" class="mt-2 px-3 py-1 border rounded text-sm hover:bg-gray-50">Change Photo</button>
              </div>
            </div>

            <div class="flex-1 space-y-3">
              <div>
                <h2 id="displayName" class="text-3xl font-bold text-gray-900">Aravind Prakash</h2>
                <p id="nickname" class="text-indigo-600 text-sm"></p>
              </div>

              <div class="flex items-center gap-6">
                <button id="editProfileBtn" class="px-4 py-1.5 text-sm font-semibold border rounded bg-gray-100 hover:bg-gray-200">Edit Profile</button>
                <div class="flex items-center gap-2 cursor-pointer">
                  <span id="friendsCount" class="font-bold text-lg">0</span>
                  <span class="text-gray-600">Friends</span>
                </div>
              </div>

              <div class="pt-2">
                <p id="bio" class="text-gray-700"></p>
              </div>
            </div>
          </div>

          <hr class="my-6 border-gray-200">

          <div>
            <h3 class="text-lg font-semibold mb-4 text-gray-800">Friends</h3>
            <div id="friendsList" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
              </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <div id="editArea" class="fixed inset-0 bg-black/40 hidden items-center justify-center p-4 z-50">
      </div>
  
  <script src="js/app-data.js"></script>
  <script src="js/profile.js"></script>
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
